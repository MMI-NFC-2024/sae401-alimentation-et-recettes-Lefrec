---
import Layout from "../layout/Layout.astro";
---

<Layout titre="Cookoo - Guide des styles">
  <!-- Couleurs -->
  <div class="flex flex-col gap-4">
    <h2>Couleurs</h2>
    <div class="flex gap-4 *:size-24 *:rounded-2xl">
      <div class="bg-light border border-not-so-light"></div>
      <div class="bg-not-so-light"></div>
      <div class="bg-not-so-dark"></div>
      <div class="bg-dark"></div>
    </div>
    <div class="flex gap-4 *:size-24 *:rounded-2xl">
      <div class="bg-recette-light"></div>
      <div class="bg-recette-dark"></div>
      <div class="bg-pro-light"></div>
      <div class="bg-pro-dark"></div>
      <div class="bg-regime-light"></div>
      <div class="bg-regime-dark"></div>
    </div>
  </div>
  <!-- Typo -->
  <div class="flex flex-col gap-4">
    <h2>Typos</h2>
    <div class="flex gap-4">
        <p class="font-logo">Schoolbell</p>
        <p class="font-heading">Roboto Serif</p>
        <p class="font-common">Roboto Flex</p>
    </div>
    <div class="flex gap-4">
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <p>Commun</p>
    </div>
  </div>
</Layout>
