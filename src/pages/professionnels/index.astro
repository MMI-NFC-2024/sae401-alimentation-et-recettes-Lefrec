---
import Layout from "../../layout/Layout.astro";
import Search from "../../components/Search.astro";
import Filtre from "../../components/Filtre.astro";
import Pagination from "../../components/Pagination.astro";
import CardProfessionnel from "../../components/CardProfessionnel.astro";
import { getProfessionnels } from "../../../backend/functions";

const url = new URL(Astro.request.url);
const search = url.searchParams.get("search") ?? "";
const professions = url.searchParams.getAll("profession").filter(Boolean);
const minNote = url.searchParams.get("minNote")
  ? Number(url.searchParams.get("minNote"))
  : undefined;
const maxNote = url.searchParams.get("maxNote")
  ? Number(url.searchParams.get("maxNote"))
  : undefined;
const page = url.searchParams.get("page")
  ? Number(url.searchParams.get("page"))
  : 1;
const perPage = url.searchParams.get("perPage")
  ? Number(url.searchParams.get("perPage"))
  : 10;

const activeFilters = [];
if (search)
  activeFilters.push({
    key: "search",
    value: search,
    label: `Recherche : ${search}`,
  });

const professionnels = await getProfessionnels({
    search,
    professions :  professions.length ? professions : undefined,
    minNote,
    maxNote,
});

console.log(professionnels);

const total = professionnels?.length ?? 0;
const maxPages = Math.max(1, Math.ceil(total / perPage));
const pageProfessionnels = professionnels.slice((page - 1) * perPage, page * perPage);
---

<Layout titre="Les professionnels" theme="pro">
  <div class="centerflex flex-col gap-5 px-6 pt-10 pb-4 w-full">
    <h1>Les professionnels</h1>
    <div class="centerflex w-full">
      <Search value={search} />
    </div>
    <div id="active-filters" class="centerflex w-full gap-2 flex-wrap">
        {
          activeFilters.map((filter) => {
            return (
              <Filtre
                content={filter.label}
                filterKey={filter.key}
                filterValue={filter.value}
              />
            );
          })
        }
      </div>
    <div class="centerflex w-full gap-5 flex-wrap">
      {
        pageProfessionnels.map((professionnel) => {
          return <CardProfessionnel {...professionnel} />;
        })
      }
    </div>

    <Pagination currentPage={page} maxPages={maxPages} theme="pro"/>
  </div>
</Layout>

<script>
  const activeFilters = document.getElementById("active-filters");

  function removeFilter(key, value) {
    updateQueryParams((params) => {
      if (key === "tags") {
        const tags = params
          .getAll("tags")
          .filter((t) => t.trim() && t !== value);
        params.delete("tags");
        tags.forEach((t) => params.append("tags", t));
        return;
      }
      params.delete(key);
    });
  }

  function updateQueryParams(updater) {
    const urlParams = new URLSearchParams(location.search);
    updater(urlParams);
    // reset pagination when filters change
    urlParams.set("page", "1");
    location.search = urlParams.toString();
  }

  activeFilters?.addEventListener("click", (event) => {
      const target = event.target;
      const deleteButton = target.closest?.(".filtre-delete");
      if (!deleteButton) return;

      const filterElement = deleteButton.closest?.(".filtre");
      if (!filterElement) return;

      const key = filterElement.dataset.filterKey;
      const value = filterElement.dataset.filterValue;
      removeFilter(key, value);
    });
</script>