---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { titre, theme = "recette", filledFooter = "true" } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Cookoo - {titre}</title>
  </head>
  <body class=`min-h-dvh flex flex-col bg-${theme}-light bg-[url(/src/assets/svg/birds.svg)] bg-repeat bg-blend-multiply`>
    <Header/>
    <main class="min-h-svh max-w-200 self-center">
      <slot />
    </main>
    <Footer fill={filledFooter}/>
  </body>
</html>
