---
import App from "../assets/svg/App.svg";
import Play from "../assets/svg/Play.svg";
import Bird from "../assets/svg/big-bird.svg";
import { getUser } from "../../backend/functions";

let user;

if (Astro.locals.pb.authStore.record) {
  user = await getUser(Astro.locals.pb.authStore.record.id);
  user.email = Astro.locals.pb.authStore.record.email;
}
---

<header class="relative">
  <!-- top -->
  <div
    class="centerflex w-full p-4 pt-12 bg-light rounded-b-3xl shadow-(--base-shadow)"
  >
    <div class="min-w-12.5 min-h-12.5"></div>
    <!-- logo -->
    <a href="/" class="logo w-full">Cookoo</a>
    <!-- burger -->
    <button
      id="open"
      class="flex flex-col p-4 justify-between min-w-12.5 h-12.5 bg-dark rounded-full *:min-w-full *:h-[2px] *:bg-light *:rounded-full"
    >
      <div></div>
      <div></div>
      <div></div>
    </button>
  </div>
  <!-- overlay (click to close) -->
  <div
    id="sidebarOverlay"
    class="fixed inset-0 z-10 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300"
  >
  </div>
  <!-- sidebar -->
  <div
    id="sidebar"
    class="fixed top-0 right-0 flex flex-col w-[300px] h-dvh bg-light z-50 transform transition-transform duration-300 ease-in-out translate-x-full shadow-(--menu-shadow)"
  >
    <!-- top copy -->
    <div class="centerflex w-full gap-2 p-4 pt-12">
      <div class="min-w-12.5 min-h-12.5"></div>
      <p class="logo w-full">Cookoo</p>
      <button
        id="close"
        class="flex flex-col p-4 gap-2 min-w-12.5 h-12.5 bg-dark rounded-full *:min-w-full"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0.382031 17.7734C-0.127344 18.2828 -0.127344 19.1086 0.382031 19.618C0.891406 20.1273 1.71729 20.1273 2.22666 19.618L0.382031 17.7734ZM10.9223 10.9223C11.4317 10.4129 11.4317 9.58715 10.9223 9.07776C10.4129 8.56836 9.58715 8.56836 9.07776 9.07776L10.9223 10.9223ZM9.07776 9.07776C8.56836 9.58715 8.56836 10.4129 9.07776 10.9223C9.58715 11.4317 10.4129 11.4317 10.9223 10.9223L9.07776 9.07776ZM19.618 2.22666C20.1273 1.71729 20.1273 0.891406 19.618 0.382031C19.1086 -0.127344 18.2828 -0.127344 17.7734 0.382031L19.618 2.22666ZM10.9223 9.07776C10.4129 8.56836 9.58715 8.56836 9.07776 9.07776C8.56836 9.58715 8.56836 10.4129 9.07776 10.9223L10.9223 9.07776ZM17.7734 19.618C18.2828 20.1273 19.1086 20.1273 19.618 19.618C20.1273 19.1086 20.1273 18.2828 19.618 17.7734L17.7734 19.618ZM9.07776 10.9223C9.58715 11.4317 10.4129 11.4317 10.9223 10.9223C11.4317 10.4129 11.4317 9.58715 10.9223 9.07776L9.07776 10.9223ZM2.22666 0.382031C1.71729 -0.127344 0.891406 -0.127344 0.382031 0.382031C-0.127344 0.891406 -0.127344 1.71729 0.382031 2.22666L2.22666 0.382031ZM2.22666 19.618L10.9223 10.9223L9.07776 9.07776L0.382031 17.7734L2.22666 19.618ZM10.9223 10.9223L19.618 2.22666L17.7734 0.382031L9.07776 9.07776L10.9223 10.9223ZM9.07776 10.9223L17.7734 19.618L19.618 17.7734L10.9223 9.07776L9.07776 10.9223ZM10.9223 9.07776L2.22666 0.382031L0.382031 2.22666L9.07776 10.9223L10.9223 9.07776Z"
            fill="white"></path>
        </svg>
      </button>
    </div>
    <!-- main items -->
    <div
      class="flex flex-col gap-2 px-4 py-10 *:text-center *:font-heading *:text-2xl"
    >
      <a href="/recettes">Recettes</a>
      <div class="w-full h-px bg-not-so-light"></div>
      <a href="/professionnels">Professionnels</a>
      <div class="w-full h-px bg-not-so-light"></div>
      <a href="/regime">Mon régime</a>
    </div>
    <!-- connection -->
     { user ? ( 
      <a href="/profile" class="centerflex">
        <img class="size-10 rounded-full object-cover" src={user.imageURL || "/avatar.png"} alt="Ta photo de profil">
        <p>{user.name}</p>
      </a>
     ) : (
      <div class="centerflex flex-col">
        <div
          class="btn"
        >
          <a class="btnText" href="/auth">Connexion</a>
        </div>
        <a class="text-not-so-dark text-base font-medium hover:underline" href="/register"
          >Créer un compte</a
        >
      </div>
     )}
    
    <!-- space -->
    <div class="relative h-full">
      <Bird class="absolute right-0 bottom-0" />
    </div>
    <!-- store -->
    <div class="centerflex p-5">
      <a href="https://www.apple.com/fr/app-store/"><App /></a>
      <a href="https://play.google.com/store/apps?hl=fr"><Play /></a>
    </div>
  </div>
</header>

<script>
  const sidebar = document.getElementById("sidebar");
  const openBtn = document.getElementById("open");
  const closeBtn = document.getElementById("close");

  const overlay = document.getElementById("sidebarOverlay");

  function openSidebar() {
    overlay?.classList.remove("opacity-0", "pointer-events-none");
    overlay?.classList.add("opacity-100");
    sidebar?.classList.remove("translate-x-full");
    sidebar?.classList.add("translate-x-0");
  }

  function closeSidebar() {
    overlay?.classList.remove("opacity-100");
    overlay?.classList.add("opacity-0", "pointer-events-none");
    sidebar?.classList.remove("translate-x-0");
    sidebar?.classList.add("translate-x-full");
  }

  openBtn?.addEventListener("click", openSidebar);
  closeBtn?.addEventListener("click", closeSidebar);
  overlay?.addEventListener("click", closeSidebar);
</script>
