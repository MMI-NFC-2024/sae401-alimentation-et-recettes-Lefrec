---
const { fill = "true" } = Astro.props;
---

<footer
  class=`centerflex flex-col p-4 ${fill == "true" ? "bg-light" : ""} rounded-t-3xl`
>
  <p class="logo">Cookoo</p>
  <div class="flex flex-wrap gap-2 justify-center *:font-light">
    <a href="/">Conditions Générales d'Utilisation</a>
    <a href="/">Politique de confidentialité</a>
    <a href="/">Mentions légales</a>
    <a href="/">Utilisation des cookies</a>
  </div>
  <div class="w-1/3 h-px bg-not-so-dark"></div>
  <p class="text-not-so-dark">
    <span class="font-logo">Cookoo</span> est un projet étudiant - 2026
  </p>
</footer>
