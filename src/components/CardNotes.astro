---
import Note from "./Note.astro";
import Star from "../assets/svg/Star.svg";

const { commentaires, note } = Astro.props;

let notes = new Array(6).fill(0);

commentaires.forEach((commentaire) => {
  notes[commentaire.note]++;
});
---

<div class="flex p-2 gap-20 w-full rounded-xl border border-not-so-light">
  <div class="flex flex-col gap-1 w-full justify-center">
    <p class="font-medium text-xl">{note} / 5</p>
    <Note note={note} />
    <p class="font-light text-xs text-not-so-dark">
      {commentaires.length} avis
    </p>
  </div>
  <div class="flex w-full flex-col-reverse">
    {
      notes.map((count, index) => {
        if (index === 0) {
          return;
        }

        const percent =
          commentaires.length > 0 ? (count / commentaires.length) * 100 : 0;

        return (
          <div class="flex gap-1 items-center w-full" key={index}>
            <p class="text-not-so-dark text-sm">{index}</p>
            <Star class="fill-gold" />
            <div class="w-full h-px bg-not-so-light">
              <div class="h-px bg-gold" style={`width: ${percent}%`} />
            </div>
          </div>
        );
      })
    }
  </div>
</div>
